# /etc/heatingpi/config.env  (owner root:pi, mode 640). Created by install-on-pi.sh.
PORT=9000
HOST=0.0.0.0
# Reuses the legacy database in place, so a rollback to the old app keeps working.
DB_PATH=/home/pi/heatingpi/_macris/test.sqlite3
WEB_DIR=/opt/heatingpi/web
# Random, generated on first install. Changing it logs everybody out.
JWT_SECRET=
TOKEN_TTL_DAYS=30
LOG_LEVEL=info
# Forward Email API token (pre-encoded Basic token).
FORWARD_EMAIL_API_TOKEN=
# Sender; its domain must be verified in the Forward Email account.
MAIL_FROM=
# Initial recipient; can be changed in the UI (Settings > Monthly temperature report).
DEFAULT_REPORT_EMAIL=
MAX_TEMPERATURE_AGE_DAYS=180
# Must equal the legacy macris Config.js values (copied automatically by install-on-pi.sh).
DB_ENCRYPTION_SALT=
DB_ENCRYPTION_PASSWORD=
